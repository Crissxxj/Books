# ------- Base de datos -------
# Cadena de conexion a PostgreSQL. Ejemplo local:
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/libreria?schema=public"

# ------- NextAuth -------
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# ------- Google OAuth -------
# Crear en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------- Payphone (pagos reales en Ecuador) -------
# Se obtienen en https://business.payphone.app -> usuario Desarrollador -> Payphone Developer
# Crea una app de tipo "WEB" y copia el Token y el StoreId
PAYPHONE_TOKEN=
PAYPHONE_STOREID=

# URL publica de tu sitio (para las redirecciones de pago de Payphone)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
